{
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "d3-svg-to-png": "^0.3.2",
    "express": "^5.3.0",
    "opentype.js": "^1.3.4",
    "uuid": "^14.0.3"
  },
  "scripts": {
    "dev": "vite src",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build src --outDir ../dist --emptyOutDir",
    "preview": "vite preview src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
